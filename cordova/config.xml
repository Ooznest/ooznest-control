<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ooznest.cnc" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Ooznest Control</name>
    <description>
        Ooznest Machine Control App
    </description>
    <author email="hello@ooznest.co.uk" href="https://ooznest.co.uk">
        Ooznest Team
    </author>
    <content src="index.html" />

    <!-- Cordova Whitelist: allow all network access (HTTP, WS, etc.) -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="ws://*/*" />
    <allow-intent href="wss://*/*" />

    <platform name="android">
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/splash.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
        <preference name="SplashScreenDelay" value="1000" />
        <preference name="FadeSplashScreenDuration" value="500" />
        <resource-file src="res/xml/device_filter.xml" target="app/src/main/res/xml/device_filter.xml" />
        <resource-file src="res/xml/network_security_config.xml" target="app/src/main/res/xml/network_security_config.xml" />
        <!-- Manifest USB/cleartext patch (edit-config does not survive prepare
             with cordova-android 14; see scripts/after-prepare-manifest.js) -->
        <hook type="after_prepare" src="scripts/after-prepare-manifest.js" />
        <!-- Re-apply cordovarduino crash/permission fixes (plugins/ is not
             git-tracked and prepare does not re-copy plugin Java) -->
        <hook type="after_prepare" src="scripts/ensure-usb-serial-fix.js" />
        <icon density="ldpi" src="resources/android/icon/drawable-ldpi-icon.png" />
        <icon density="mdpi" src="resources/android/icon/drawable-mdpi-icon.png" />
        <icon density="hdpi" src="resources/android/icon/drawable-hdpi-icon.png" />
        <icon density="xhdpi" src="resources/android/icon/drawable-xhdpi-icon.png" />
        <icon density="xxhdpi" src="resources/android/icon/drawable-xxhdpi-icon.png" />

    </platform>
</widget>
